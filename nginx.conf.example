# Nginx reverse-proxy configuration for The Affiliate Week.
# Copy this file to your Nginx sites-available directory, adjust the
# server_name values, enable the site, then run certbot for SSL.

server {
  listen 80;
  listen [::]:80;
  server_name theaffiliateweek.com www.theaffiliateweek.com;

  # Redirect all HTTP traffic to HTTPS. Certbot will update this block
  # after issuing your certificate.
  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name theaffiliateweek.com www.theaffiliateweek.com;

  # These certificate paths are managed by Certbot. Update them if you
  # obtained the certificate through another provider.
  ssl_certificate /etc/letsencrypt/live/theaffiliateweek.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/theaffiliateweek.com/privkey.pem;

  # Security headers.
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # Proxy all requests to the Node app running on port 3000.
  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_cache_bypass $http_upgrade;
  }
}
