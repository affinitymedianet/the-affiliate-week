rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------ helpers ------------------------------- */

    function roleDoc() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data;
    }
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && roleDoc().active == true;
    }
    function isAdmin() {
      return isStaff() && roleDoc().role == 'admin';
    }
    function isEmail(value) {
      return value is string && value.size() <= 255 && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }
    function maxLen(value, n) {
      return !(value is string) || value.size() <= n;
    }

    /* --------------------- published content collections ------------------- */
    /* Anyone may read documents that are published; staff may read and write
       everything (including drafts). */

    match /jobs/{id} {
      allow read: if resource.data.published == true || isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /deals/{id} {
      allow read: if resource.data.published == true || isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /events/{id} {
      allow read: if resource.data.published == true || isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /issues/{id} {
      allow read: if resource.data.published == true || isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    /* ------------------------------ settings ------------------------------ */

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* -------------------------- public submissions ------------------------- */

    match /submissions/{id} {
      allow read, update: if isStaff();
      allow delete: if isAdmin();
      allow create: if request.resource.data.kind in ['event', 'job', 'offer']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && maxLen(request.resource.data.organisation, 200)
        && maxLen(request.resource.data.url, 500)
        && maxLen(request.resource.data.location, 200)
        && maxLen(request.resource.data.happens_on, 100)
        && maxLen(request.resource.data.details, 2000)
        && request.resource.data.submitter_name is string
        && request.resource.data.submitter_name.size() <= 120
        && isEmail(request.resource.data.submitter_email)
        && request.resource.data.status == 'new';
    }

    match /sponsor_enquiries/{id} {
      allow read, update: if isStaff();
      allow delete: if isAdmin();
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 200
        && isEmail(request.resource.data.email)
        && maxLen(request.resource.data.website, 500)
        && maxLen(request.resource.data.budget, 100)
        && maxLen(request.resource.data.message, 2000)
        && request.resource.data.status == 'new';
    }

    /* ------------------------------ subscribers ---------------------------- */
    /* The document id is the subscriber's private unsubscribe token, so only a
       holder of that token can read the row or opt out. */

    match /subscribers/{token} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if isEmail(request.resource.data.email)
        && request.resource.data.source in ['hero', 'footer', 'cta', 'website', 'submit']
        && request.resource.data.status == 'active';
      allow update: if isStaff()
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'unsubscribed_at'])
            && request.resource.data.status == 'unsubscribed');
      allow delete: if isAdmin();
    }

    /* -------------------------------- staff -------------------------------- */

    match /roles/{uid} {
      // A signed-in user may read their own role record; admins manage all.
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /audit_log/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
