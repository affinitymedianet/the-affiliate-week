# ---------------------------------------------------------------------------
# The Affiliate Week — environment
# Copy to `.env` on your server (never commit `.env`) and fill in the values.
# ---------------------------------------------------------------------------

# --- Firebase web app config (publishable) ---------------------------------
# These ship to the browser. Firestore/Storage security rules — not secrecy —
# protect your data. Values come from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=the-affiliate-week.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=the-affiliate-week
VITE_FIREBASE_STORAGE_BUCKET=the-affiliate-week.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=808833159041
VITE_FIREBASE_APP_ID=1:808833159041:web:d53fc2c7fd0ce2175da280
VITE_FIREBASE_MEASUREMENT_ID=G-CJBJTDNTGS

# --- Site ------------------------------------------------------------------
# Canonical origin, used for sitemap.xml, canonical tags and share URLs.
VITE_SITE_URL=https://theaffiliateweek.com

# --- Server runtime (secret — never prefix these with VITE_) ---------------
# Anything VITE_* is inlined into the browser bundle. Secrets must NOT be VITE_.
PORT=3000
NODE_ENV=production

# Optional: server-side Firebase Admin credentials, only needed if you later add
# server-side jobs (scheduled publishing, exports). Paste the service-account
# JSON as one line, or point at a file readable only by the app user.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/etc/theaffiliateweek/service-account.json

# Day-to-day API keys (ESP, transactional email, reCAPTCHA, Slack) are managed
# in the admin UI at /admin/integrations and stored in Firestore under
# `private_settings/integrations` (admin-read-only). You do not need them here.
