rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function roleDoc() {
      return firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data;
    }
    function isStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/roles/$(request.auth.uid))
        && roleDoc().active == true;
    }

    // Brand and cover assets are shown on the public site.
    match /brand/{file} {
      allow read: if true;
      allow write: if isStaff()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
